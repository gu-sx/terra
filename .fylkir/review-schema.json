{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "acceptance",
    "findings"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "description": "Two or three sentences: what the change does and the reviewer's overall assessment."
    },
    "acceptance": {
      "type": "array",
      "description": "One entry per acceptance-evidence item in the issue.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "met",
          "evidence"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "met": {
            "type": "string",
            "enum": [
              "yes",
              "partly",
              "no"
            ]
          },
          "evidence": {
            "type": "string",
            "description": "Test, file or output that shows it, or what is missing."
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "category",
          "file",
          "line",
          "summary",
          "failure_scenario"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "compatibility",
              "execution-environment",
              "acceptance",
              "scope",
              "tests",
              "architecture",
              "design"
            ]
          },
          "file": {
            "type": "string",
            "description": "Repository-relative path."
          },
          "line": {
            "type": "integer",
            "description": "1-indexed line, or 0 if the finding is about a missing file."
          },
          "summary": {
            "type": "string",
            "description": "One sentence stating the defect."
          },
          "failure_scenario": {
            "type": "string",
            "description": "Concrete inputs or state leading to the wrong outcome."
          }
        }
      }
    }
  }
}
